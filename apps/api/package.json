{
  "name": "@mishwar/api",
  "version": "0.1.0",
  "private": true,
  "description": "Mishwar Yemen API. NestJS application layer over the domain core.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main",
    "test:domain": "tsx --test src/domain/*.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma:db-pull": "prisma db pull",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.1.1",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "prisma": "5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
