generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id            BigInt   @id @default(autoincrement())
  actor_user_id String?  @db.Uuid
  actor_role    String?
  action        String
  entity_type   String
  entity_id     String?
  before_state  Json?
  after_state   Json?
  reason        String?
  ip            String?  @db.Inet
  user_agent    String?
  request_id    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action, created_at(sort: Desc)], map: "audit_logs_action_idx")
  @@index([actor_user_id, created_at(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "audit_logs_entity_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model currencies {
