APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://mishwar:mishwar_dev_only@localhost:5432/mishwar?sslmode=disable
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# Authentication & JWT Access Tokens (minimum 32 bytes in production)
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-32-bytes-minimum!
JWT_ISSUER=mishwar-api
JWT_AUDIENCE=mishwar-clients
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# OTP Challenge Service (minimum 32 bytes in production)
OTP_PEPPER=dev-only-otp-pepper-secret-32-bytes-minimum!!
OTP_TTL=5m
OTP_MAX_ATTEMPTS=3

# OTP Request Rate Limiter (minimum 32 bytes in production)
OTP_LIMITER_KEY=dev-only-otp-rate-limit-key-32-bytes-minimum!
OTP_RATE_LIMIT_WINDOW=15m
OTP_RATE_LIMIT_PHONE_MAX=3
OTP_RATE_LIMIT_IP_MAX=10

# OTP Delivery Provider (console | stub | noop; console forbidden in production)
OTP_PROVIDER=console
OTP_DEV_DISPLAY=false

# Start code secret (minimum 32 bytes in production; used for ride start-code HMAC)
START_CODE_SECRET=dev-only-start-code-secret-32-bytes-minimum!!

# HTTP server timeouts
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
