FCM_CREDENTIALS=
MAP_PROVIDER=stub
MAP_API_KEY=
# Google Maps key used by the Flutter apps (AppConstants.mapApiKey reads this
# from the process environment; platform files hard-code the same demo key).
MISHWAR_MAP_API_KEY=AIzaSyCpKncPoVGh4jAgUfNINtSKTPiuzbkvhnk
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Background sweeper for dispatch state (offer + search expiry). Every API
# replica runs its own; sweep() claims rows with FOR UPDATE SKIP LOCKED, so
# replicas cannot double-apply a transition. Set DISPATCH_SWEEPER_ENABLED=false
# to turn it off (integration tests do this and drive POST /dispatch/sweep
# explicitly instead). Interval is clamped to a 1000 ms floor.
DISPATCH_SWEEPER_ENABLED=true
DISPATCH_SWEEP_INTERVAL_MS=5000
